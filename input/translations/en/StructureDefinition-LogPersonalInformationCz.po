msgid "2a. Osobní a demografické údaje"
msgstr "2a. Personal and demographic information"

#: StructureDefinition.element.LogPersonalInformationCz/short
msgctxt "StructureDefinition.element.LogPersonalInformationCz/short"
msgid "2a. Osobní a demografické údaje"
msgstr "2a. Personal and demographic information"

#: StructureDefinition.element.LogPersonalInformationCz/definition
msgctxt "StructureDefinition.element.LogPersonalInformationCz/definition"
msgid "Položky 2a.1–2a.9 datasetu RD_Data_Elements_CZ_EHR_VFN_16_9_VS.xlsx. Spojuje osobní a demografické údaje, které mají ve zdroji společné označení 2a. Povinné položky se vztahují k přítomné sekci."
msgstr "Items 2a.1–2a.9 of the rare disease dataset. Combines the personal and demographic source headings numbered 2a. Required items apply when this subsection is used."

#: StructureDefinition.element.LogPersonalInformationCz.rodnePrijmeni/short
msgctxt "StructureDefinition.element.LogPersonalInformationCz.rodnePrijmeni/short"
