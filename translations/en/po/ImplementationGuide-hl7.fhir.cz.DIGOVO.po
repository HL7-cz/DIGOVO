# ImplementationGuide.definition.resource.name
#: ImplementationGuide.definition.resource.name
msgid "1. Souhlas s opakovaným použitím dat"
msgstr ""

# ImplementationGuide.definition.resource.description
#: ImplementationGuide.definition.resource.description
msgid "Záznam o souhlasu pacienta nebo zákonného zástupce s opakovaným použitím dat pacienta."
msgstr ""

# ImplementationGuide.definition.resource.name
#: ImplementationGuide.definition.resource.name
msgid "10. Poskytnutá péče"
msgstr ""

# ImplementationGuide.definition.resource.description
#: ImplementationGuide.definition.resource.description
msgid "Logický model pro zachycení údajů o zdravotní péči poskytnuté pacientovi, včetně typu intervence, účelu, zapojení do systémů jako CPMS, profese poskytovatelů a lokalizace centra péče. Vhodné primárně pro standardní dokumentaci; pro registry může být problematické kvůli variabilitě údajů."
msgstr ""

# ImplementationGuide.definition.resource.name
#: ImplementationGuide.definition.resource.name
msgid "11. Výzkum"
msgstr ""

# ImplementationGuide.definition.resource.description
#: ImplementationGuide.definition.resource.description
msgid "Logický model pro zachycení údajů o účasti pacienta na výzkumu nebo studii včetně dostupnosti biologických vzorků a souhlasu s kontaktováním. Struktura odpovídá českým národním požadavkům a je v souladu s CDE."
msgstr ""

# ImplementationGuide.definition.resource.name
#: ImplementationGuide.definition.resource.name
msgid "12. Užitečné informace"
msgstr ""

# ImplementationGuide.definition.resource.description
#: ImplementationGuide.definition.resource.description
msgid "Logický model pro zachycení doplňujících informací o onemocnění, doporučeních a hlavních varováních důležitých pro péči o pacienta. Součástí může být i pacientský souhrn."
msgstr ""

# ImplementationGuide.definition.resource.name
#: ImplementationGuide.definition.resource.name
msgid "2. Informace o pacientovi"
msgstr ""

# ImplementationGuide.definition.resource.description
#: ImplementationGuide.definition.resource.description
msgid "Identifikace případu a příznak plodu podle položek 2.1–2.2 datasetu RD_Data_Elements_CZ_EHR_VFN_16_9_VS.xlsx. Osobní údaje 2a a údaje o plodu 2b jsou samostatné dílčí modely. Větve jsou volitelné na úrovni struktury; jejich použitelnost závisí na příznaku plodu a klinickém kontextu."
msgstr ""

# ImplementationGuide.definition.resource.name
#: ImplementationGuide.definition.resource.name
msgid "2a. Osobní a demografické údaje"
msgstr ""

# ImplementationGuide.definition.resource.description
#: ImplementationGuide.definition.resource.description
msgid "Položky 2a.1–2a.9 datasetu RD_Data_Elements_CZ_EHR_VFN_16_9_VS.xlsx. Spojuje osobní a demografické údaje, které mají ve zdroji společné označení 2a. Povinné položky se vztahují k přítomné sekci."
msgstr ""

# ImplementationGuide.definition.resource.name
#: ImplementationGuide.definition.resource.name
msgid "2b. Údaje o plodu a matce"
msgstr ""

# ImplementationGuide.definition.resource.description
#: ImplementationGuide.definition.resource.description
msgid "Položky 2b.1–2b.11 datasetu RD_Data_Elements_CZ_EHR_VFN_16_9_VS.xlsx. Záznam se vede pro každý postižený plod samostatně. Povinné položky platí při použití této sekce; způsob zachycení neznámých hodnot musí určit konkrétní implementace."
msgstr ""

# ImplementationGuide.definition.resource.name
#: ImplementationGuide.definition.resource.name
msgid "3. Diagnóza vzácného onemocnění"
msgstr ""

# ImplementationGuide.definition.resource.description
#: ImplementationGuide.definition.resource.description
msgid "Záznam diagnózy vzácného onemocnění včetně klasifikace, potvrzovací metody a genetických údajů."
msgstr ""

# ImplementationGuide.definition.resource.name
#: ImplementationGuide.definition.resource.name
msgid "4. Anamnéza onemocnění"
msgstr ""

# ImplementationGuide.definition.resource.description
#: ImplementationGuide.definition.resource.description
msgid "Logický model pro sekci anamnézy v datasetu vzácných onemocnění."
msgstr ""

# ImplementationGuide.definition.resource.name
#: ImplementationGuide.definition.resource.name
msgid "5. Prenatální a perinatální údaje"
msgstr ""

# ImplementationGuide.definition.resource.description
#: ImplementationGuide.definition.resource.description
msgid "Logický model pro prenatální a perinatální údaje relevantní především u dětských pacientů."
msgstr ""

# ImplementationGuide.definition.resource.name
#: ImplementationGuide.definition.resource.name
msgid "6. Rodinná anamnéza"
msgstr ""

# ImplementationGuide.definition.resource.description
#: ImplementationGuide.definition.resource.description
msgid "Logický model pro záznam informací o rodinných předcích ve vztahu k vzácnému onemocnění."
msgstr ""

# ImplementationGuide.definition.resource.name
#: ImplementationGuide.definition.resource.name
msgid "7. Životní stav"
msgstr ""

# ImplementationGuide.definition.resource.description
#: ImplementationGuide.definition.resource.description
msgid "Logický model pro záznam životního stavu pacienta ve vztahu k vzácnému onemocnění."
msgstr ""

# ImplementationGuide.definition.resource.name
#: ImplementationGuide.definition.resource.name
msgid "8. Léčba"
msgstr ""

# ImplementationGuide.definition.resource.description
#: ImplementationGuide.definition.resource.description
msgid "Logický model pro zachycení informací o terapii u pacientů, zejména při léčbě vzácných onemocnění. Obsahuje informace o léčivech, dávkování, dalších intervencích a způsobech léčby. V souladu s českými národními požadavky a standardem PZ."
msgstr ""

# ImplementationGuide.definition.resource.name
#: ImplementationGuide.definition.resource.name
msgid "9. Trajektorie péče"
msgstr ""

# ImplementationGuide.definition.resource.description
#: ImplementationGuide.definition.resource.description
msgid "Logický model pro zachycení informací o klinické trajektorii (care pathway) pacienta v rámci péče o vzácné onemocnění. Obsahuje informace o odesílajícím subjektu, datu přijetí do specializovaného centra, zapojených lékařích a klinických službách."
msgstr ""

# ImplementationGuide.definition.resource.name
#: ImplementationGuide.definition.resource.name
msgid "Ano / Ne / Neznámé / Nezjišťováno (DIGOVO)"
msgstr ""

# ImplementationGuide.definition.resource.description
#: ImplementationGuide.definition.resource.description
msgid "Čtyřstavové odpovědi podle datasetu vzácných onemocnění. Neznámá odpověď a nezjišťování jsou odlišné od záporné odpovědi."
msgstr ""

# ImplementationGuide.definition.resource.name
#: ImplementationGuide.definition.resource.name
msgid "Biologické metody použité v diagnostice (DIGOVO)"
msgstr ""

# ImplementationGuide.definition.resource.description
#: ImplementationGuide.definition.resource.description
